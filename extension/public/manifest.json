{
  "manifest_version": 3,
  "name": "ForgetMeNot — AI Search Assistant",
  "version": "1.0.0",
  "description": "Your AI assistant that never forgets — search across Gmail, Drive, Slack & more",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://slack.com/api/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle ForgetMeNot (Ctrl+Shift+K)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle ForgetMeNot side panel"
    },
    "voice_search": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Voice search with ForgetMeNot"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
